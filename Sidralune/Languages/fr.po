msgid "The backlash test was stopped."
msgstr "Le test de jeu a été arrêté."

#: Sidralune.Devices/Guiding/GuidingAssistant.cs
msgid "Minimum move RA {0:0.00} px and Dec {1:0.00} px, a little under the seeing's wander."
msgstr "Déplacement minimal AD {0:0.00} px et Dec {1:0.00} px, un peu sous l'agitation due au seeing."

#: Sidralune.Devices/Guiding/GuidingAssistant.cs
msgid "Dec backlash is small ({0:0} ms): no compensation needed."
msgstr "Le jeu en Dec est faible ({0:0} ms) : aucune compensation n'est nécessaire."

#: Sidralune.Devices/Guiding/GuidingAssistant.cs
msgid "Turn on Dec backlash compensation at {0:0} ms (adapting between {1:0} and {2:0} ms)."
msgstr "Activez la compensation du jeu en Dec à {0:0} ms (elle s'adapte entre {1:0} et {2:0} ms)."

#: Sidralune.Devices/Guiding/GuidingAssistant.cs
msgid "Dec backlash is large ({0:0.0} s): guide Dec North only, against the drift."
msgstr "Le jeu en Dec est important ({0:0.0} s) : guidez la Dec vers le nord seulement, contre la dérive."

#: Sidralune.Devices/Guiding/GuidingAssistant.cs
