msgstr "Запри и анализирај"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Apply the ticked settings"
msgstr "Примени ги означените поставки"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Calibrates near the meridian and the celestial equator, where calibration is most reliable, on the side the mount points to now, then rates the calibration."
msgstr "Калибрира близу меридијанот и небесниот екватор, каде калибрацијата е најсигурна, на страната каде што монтажот сега покажува, а потоа ја оценува калибрацијата."

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Hour angle (h)"
msgstr "Часовен агол (h)"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Declination (°)"
msgstr "Деклинација (°)"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Slew and calibrate"
msgstr "Заврти и калибрирај"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Return"
msgstr "Врати"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Suggest again"
msgstr "Предложи повторно"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Calibration Assistant"
msgstr "Асистент за калибрација"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Guiding Assistant"
msgstr "Асистент за водење"

