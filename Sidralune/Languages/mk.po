msgstr "Водењето запре, па запре и асистентот за водење."

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Connect a telescope: the assistant slews it."
msgstr "Поврзете телескоп: асистентот го врти."

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "West of the meridian, {0:0}° up."
msgstr "Западно од меридијанот, на {0:0}° височина."

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "East of the meridian, {0:0}° up."
msgstr "Источно од меридијанот, на {0:0}° височина."

