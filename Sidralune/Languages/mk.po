msgid "Worm period (s)"
msgstr "Период на полжавот (s)"

#: Sidralune/Views/ObservatoryView.Guiding.cs
msgid "Period"
msgstr "Период"

#: Sidralune/Views/ObservatoryView.Guiding.cs
