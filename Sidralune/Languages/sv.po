msgstr "Anslut monteringen: driftinriktningen behöver veta vart den pekar."

#: Sidralune/Views/ObservatoryView.Polar.cs
msgid "altitude error {0:+0.0;-0.0}′ ± {1:0.0}′"
msgstr "höjdfel {0:+0.0;-0.0}′ ± {1:0.0}′"

#: Sidralune/Views/ObservatoryView.Polar.cs
msgid "azimuth error {0:+0.0;-0.0}′ ± {1:0.0}′"
msgstr "azimutfel {0:+0.0;-0.0}′ ± {1:0.0}′"

