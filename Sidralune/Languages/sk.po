#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Drift alignment needs the mount connected, to know where it points."
msgstr "Nastavenie driftom potrebuje pripojenú montáž, aby vedelo, kam mieri."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Point near the celestial equator (Dec within ±30°): near the meridian for the azimuth error, or 25–35° up in the east or west for the altitude error."
msgstr "Mierte blízko nebeského rovníka (Dec v rozsahu ±30°): blízko meridiánu pre chybu azimutu, alebo 25–35° nad obzorom na východe či západe pre chybu výšky."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Near the meridian: this measures the azimuth error."
msgstr "Blízko meridiánu: tu sa meria chyba azimutu."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "In the east: this measures the altitude error."
msgstr "Na východe: tu sa meria chyba výšky."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "In the west: this measures the altitude error."
msgstr "Na západe: tu sa meria chyba výšky."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "This measures the altitude error, though lower in the east or west would tell it better."
msgstr "Tu sa meria chyba výšky, nižšie na východe či západe by sa však ukázala lepšie."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "This measures the azimuth error, though nearer the meridian would tell it better."
msgstr "Tu sa meria chyba azimutu, bližšie k meridiánu by sa však ukázala lepšie."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Start guiding first: drift alignment measures while guiding with the Dec corrections held back."
msgstr "Najprv spustite pointáciu: nastavenie driftom meria počas pointácie so zadržanými korekciami Dec."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Move the polar axis {0} by {1:0.0}′"
msgstr "Posuňte polárnu os {0} o {1:0.0}′"

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Stop guiding first: the mount turns between the frames."
msgstr "Najprv zastavte pointáciu: montáž sa medzi snímkami otáča."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "No guide frame came."
msgstr "Neprišiel žiadny pointačný snímok."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Frame {0} of 3…"
msgstr "Snímok {0} z 3…"

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Frame {0} could not be plate-solved."
msgstr "Snímok {0} sa nepodarilo astrometricky vyriešiť."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Turning RA {0:0}° east…"
msgstr "Otáčanie RA o {0:0}° na východ…"

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Turning RA {0:0}° west…"
msgstr "Otáčanie RA o {0:0}° na západ…"

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Three frames are needed."
msgstr "Sú potrebné tri snímky."

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "The frames did not turn: was RA moved between them?"
msgstr "Snímky sa neotočili: pohla sa medzi nimi RA?"

#: Sidralune.Devices/Guiding/GuidePolarAlignment.cs
msgid "Stop guiding first: polar drift alignment follows a star while the mount only tracks."
msgstr "Najprv zastavte pointáciu: nastavenie polárnym driftom sleduje hviezdu, kým montáž len sleduje oblohu."

#: Sidralune.Devices/Guiding/GuiderServer.cs
msgid "Port {0} is in use (is PHD2 running?)"
msgstr "Port {0} je obsadený (beží PHD2?)"

#: Sidralune.Devices/Guiding/GuiderServer.cs
msgid "Connect the guide camera in Sidralune's Observatory → Equipment."
msgstr "Pripojte pointačnú kameru v Sidralune v Pozorovanie → Vybavenie."

#: Sidralune.Devices/Guiding/GuiderServer.cs
msgid "Not looping."
msgstr "Nebeží žiadna slučka."

#: Sidralune.Devices/Guiding/GuiderServer.cs
msgid "Settling is still going on."
msgstr "Ustaľovanie ešte prebieha."

#: Sidralune.Devices/Guiding/GuiderServer.cs
msgid "Settling timed out."
msgstr "Ustaľovanie trvalo príliš dlho."

#: Sidralune.Devices/Guiding/GuiderServer.cs Sidralune.Devices/Guiding/SidraluneGuider.Ao.cs
msgid "No AO connected."
msgstr "Ustaľovanie zlyhalo."

#: Sidralune.Devices/Guiding/GuiderServer.cs
