msgstr "Pievienojiet montējumu: izlīdzināšanai ar dreifu jāzina, kur tas vērsts."

#: Sidralune/Views/ObservatoryView.Polar.cs
msgid "altitude error {0:+0.0;-0.0}′ ± {1:0.0}′"
msgstr "augstuma kļūda {0:+0.0;-0.0}′ ± {1:0.0}′"

